# Browser key: restrict by HTTP referrer and enable Maps JavaScript API + Places API (New).
VITE_GOOGLE_MAPS_API_KEY=

# Server-only key used by /api/routes. Never prefix with VITE_.
GOOGLE_ROUTES_API_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional and intentionally not implemented until the core flow is stable.
ELEVENLABS_API_KEY=
